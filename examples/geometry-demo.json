          "show_line_numbers": true,
          "auto_scroll": true,
          "size": { "width": 1160, "height": 480 },
          "position": "absolute",
          "x": 60,
          "y": 160,
          "chrome": { "enabled": true, "title": "main.rs" },
          "reveal": { "kind": "line", "duration": 5.0 },
          "code": "use rustmotion::engine::render;\nuse rustmotion::layout::{Constraints, LayoutNode};\n\nfn main() {\n    let scenario = load();\n    let viewport = (1280, 720);\n    for view in scenario.views.iter() {\n        for scene in view.scenes.iter() {\n            let children = render::deserialize_children(scene);\n            let layout = render::compute_root_layout(\n                &children,\n                &scenario.video,\n                scene.layout.as_ref(),\n            );\n            walk_tree(&layout, viewport);\n        }\n    }\n    println!(\"validation complete\");\n}\n\nfn walk_tree(node: &LayoutNode, vp: (u32, u32)) {\n    if node.x + node.width > vp.0 as f32 {\n        eprintln!(\"viewport overflow on x\");\n    }\n    for child in &node.children {\n        walk_tree(child, vp);\n    }\n}\n\nfn load() -> Scenario {\n    serde_json::from_str(SRC).unwrap()\n}"
        }
      ]
